{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coverage Cockpit",
  "version": "0.1.0",
  "identifier": "app.coverage-cockpit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Coverage Cockpit", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
